#!/usr/bin/env sh

test -z "${TF_PORT}" && {
    echo "[WARN] \$TF_PORT unset, using default 27015"
    export TF_PORT=27015
}

test -z "${TF_HOST}" && {
    echo "[WARN] \$TF_HOST unset, using default 127.0.0.1"
    export TF_HOST="127.0.0.1"
}

test -z "${TF_SERVER_NAME}" && {
    echo "[WARN] \$TF_SERVER_NAME unset, using default tf2classified-in-docker"
    export TF_SERVER_NAME="tf2classified-in-docker"
}

test -z "${TF_MOTD}" && {
    echo "[WARN] \$TF_MOTD unset, using default greeting"
    export TF_MOTD="Welcome to the TF2 Classified server!"
}

test -z "${TF_MAX_PLAYERS}" && {
    echo "[WARN] \$TF_MAX_PLAYERS unset, using default 24"
    export TF_MAX_PLAYERS=24
}

test -z "${TF_UPDATE_INTERVAL_SECONDS}" && {
    echo "[WARN] \$TF_UPDATE_INTERVAL_SECONDS unset, using default 300"
    export TF_UPDATE_INTERVAL_SECONDS=300
}

test -z "${TF_STARTUP_MAP}" && {
    echo "[WARN] \$TF_STARTUP_MAP unset, using default 'ctf_2fort'"
    export TF_STARTUP_MAP=ctf_2fort
}

if test -n "${TF_PASSWORD}"; then
    test -n "${TF_PASSWORD_FILE}" && echo "[WARN] \$TF_PASSWORD and \$TF_PASSWORD_FILE both present; ignoring \$TF_PASSWORD_FILE"
else
    if test -n "${TF_PASSWORD_FILE}"; then
        test -f "${TF_PASSWORD_FILE}" || {
            echo "[ERROR] \$TF_PASSWORD_FILE not found (${TF_PASSWORD_FILE})"
            return 1
        }
        test -r "${TF_PASSWORD_FILE}" || {
            echo "[ERROR] \$TF_PASSWORD_FILE exists but is not readable (${TF_PASSWORD_FILE})"
            return 1
        }
        TF_PASSWORD="$(cat "${TF_PASSWORD_FILE}")"
        export TF_PASSWORD
    fi
fi

if test -n "${TF_RCON_PASSWORD}"; then
    test -n "${TF_RCON_PASSWORD_FILE}" && echo "[WARN] \$TF_RCON_PASSWORD and \$TF_RCON_PASSWORD_FILE both present; ignoring \$TF_RCON_PASSWORD_FILE"
else
    if test -n "${TF_RCON_PASSWORD_FILE}"; then
        test -f "${TF_RCON_PASSWORD_FILE}" || {
            echo "[ERROR] \$TF_RCON_PASSWORD_FILE not found (${TF_RCON_PASSWORD_FILE})"
            return 1
        }
        test -r "${TF_RCON_PASSWORD_FILE}" || {
            echo "[ERROR] \$TF_RCON_PASSWORD_FILE exists but is not readable (${TF_RCON_PASSWORD_FILE})"
            return 1
        }
        TF_RCON_PASSWORD="$(cat "${TF_RCON_PASSWORD_FILE}")"
        export TF_RCON_PASSWORD
    else
        TF_RCON_PASSWORD="$(head -c 24 /dev/urandom | base64)"
        echo "[WARN] \$TF_RCON_PASSWORD and \$TF_RCON_PASSWORD_FILE unset, using autogenerated password '${TF_RCON_PASSWORD}'"
        export TF_RCON_PASSWORD
    fi
fi

test -z "${TF2_APPID}" && {
    echo "[ERROR] \$TF2_APPID not set"
    return 1
}

test -z "${TF2_CLASSIFIED_APPID}" && {
    echo "[ERROR] \$TF2_CLASSIFIED_APPID not set"
    return 1
}

export LD_LIBRARY_PATH=".:bin/linux64${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
export PATH="${PATH}:/opt/steamcmd"

echo "[INFO] Server vars set"
